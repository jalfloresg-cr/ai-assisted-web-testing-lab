# Copia este archivo a .env.qa. Las variables del shell/CI tienen prioridad.

# --- Ambiente bajo prueba ---
BASE_URL=http://192.168.49.2:30081/

# Hosts extra permitidos por Skyvern (JSON). El host de BASE_URL se agrega solo
# en el proceso de pytest si ALLOWED_HOSTS no está definido.
# ALLOWED_HOSTS='["192.168.49.2","sso.interno"]'

# --- Skyvern ---
SKYVERN_BASE_URL=http://localhost:8000
SKYVERN_API_KEY=
HEADLESS=false
SKYVERN_TIMEOUT=600

# --- Datos por smoke ---------------------------------------------------------
# Perfil: smoke_login_personal
SMOKE_LOGIN_PERSONAL_USERNAME=cliente
SMOKE_LOGIN_PERSONAL_PASSWORD=

# Perfil: smoke_transfer_personal
SMOKE_TRANSFER_PERSONAL_USERNAME=cliente
SMOKE_TRANSFER_PERSONAL_PASSWORD=
SMOKE_TRANSFER_PERSONAL_OTP=
SMOKE_TRANSFER_SOURCE_ACCOUNT=
SMOKE_TRANSFER_DESTINATION_ACCOUNT=
